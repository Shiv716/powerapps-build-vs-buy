DATABASE_URL="postgresql://app:app@localhost:5432/platform"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Microsoft Entra ID — the production sign-in path. Required in production;
# can be left as placeholders in development if you use the dev sign-in below.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=""

# Development sign-in: when NODE_ENV != "production" (e.g. `pnpm dev`), the
# sign-in page also offers a passwordless dropdown of seeded users so the app
# can be run and demoed without a Microsoft tenant. It requires no extra
# variables and is not registered in production builds.
